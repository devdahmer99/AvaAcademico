@page
@model AvaAcademico.Pages.Certificados.EmitirModel
@{
    Layout = null; // Layout limpo e independente para impressão perfeita em PDF
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Certificado - @Model.Curso.Titulo - @(Model.Aluno.NomeCompleto ?? Model.Aluno.UserName)</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;800&family=Inter:wght@400;500;600;700&family=Pinyon+Script&display=swap" rel="stylesheet">
    
    <style>
        @@page {
            size: A4 landscape;
            margin: 0;
        }

        body {
            background-color: #525659;
            font-family: 'Inter', sans-serif;
            margin: 0;
            padding: 20px 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            min-height: 100vh;
        }

        .no-print-bar {
            width: 100%;
            max-width: 1100px;
            margin-bottom: 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px 20px;
            background: #ffffff;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.15);
        }

        .certificate-sheet {
            width: 297mm;
            height: 210mm;
            background: #ffffff;
            position: relative;
            padding: 15mm;
            box-sizing: border-box;
            box-shadow: 0 10px 30px rgba(0,0,0,0.3);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            overflow: hidden;
        }

        .border-outer {
            border: 4px solid #004ba0;
            height: 100%;
            padding: 6px;
            position: relative;
            box-sizing: border-box;
        }

        .border-inner {
            border: 1px solid #d4af37;
            height: 100%;
            padding: 20px 35px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            text-align: center;
            position: relative;
            background: linear-gradient(135deg, #ffffff 0%, #fafbfc 100%);
        }

        .cert-header {
            margin-top: 5px;
        }

        .cert-institution {
            font-family: 'Cinzel', serif;
            font-size: 1.6rem;
            letter-spacing: 4px;
            color: #004ba0;
            font-weight: 800;
            text-transform: uppercase;
        }

        .cert-sub-institution {
            font-size: 0.8rem;
            letter-spacing: 2px;
            color: #666;
            text-transform: uppercase;
            margin-top: 2px;
        }

        .cert-title {
            font-family: 'Cinzel', serif;
            font-size: 2.3rem;
            color: #1a1a1a;
            letter-spacing: 6px;
            margin-top: 15px;
            font-weight: 700;
            text-transform: uppercase;
        }

        .cert-body {
            margin: 15px 0;
        }

        .cert-text-intro {
            font-size: 0.95rem;
            color: #555;
            margin-bottom: 8px;
        }

        .cert-student-name {
            font-family: 'Cinzel', serif;
            font-size: 2rem;
            font-weight: 700;
            color: #004ba0;
            border-bottom: 2px solid #d4af37;
            display: inline-block;
            padding: 0 30px 4px 30px;
            margin: 5px 0 12px 0;
            text-transform: uppercase;
        }

        .cert-description {
            font-size: 1.05rem;
            color: #444;
            max-width: 850px;
            margin: 0 auto;
            line-height: 1.6;
        }

        .cert-course-name {
            font-weight: 700;
            color: #000;
            font-size: 1.15rem;
        }

        .cert-footer {
            margin-bottom: 5px;
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            padding: 0 20px;
        }

        .signature-box {
            text-align: center;
            width: 220px;
        }

        .signature-line {
            border-top: 1px solid #333;
            margin-top: 8px;
            padding-top: 4px;
            font-size: 0.75rem;
            color: #444;
            font-weight: 600;
        }

        .seal-badge {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            background: linear-gradient(135deg, #d4af37 0%, #aa8c2c 100%);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            color: #fff;
            box-shadow: 0 4px 10px rgba(212, 175, 55, 0.4);
            border: 2px dashed #fff;
        }

        .verification-info {
            text-align: left;
            font-size: 0.7rem;
            color: #666;
            line-height: 1.4;
        }

        .signature-hand {
            font-family: 'Pinyon Script', cursive;
            font-size: 1.8rem;
            color: #002b66;
            margin-bottom: -8px;
        }

        @@media print {
            body {
                background: none;
                padding: 0;
            }
            .no-print-bar {
                display: none !important;
            }
            .certificate-sheet {
                box-shadow: none;
                width: 100vw;
                height: 100vh;
                padding: 10mm;
            }
        }
    </style>
</head>
<body>

    <!-- Barra de Controle Superior (Não é impressa) -->
    <div class="no-print-bar">
        <div class="d-flex align-items-center gap-3">
            <a href="/Perfil" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                <i class="bi bi-arrow-left me-1"></i> Voltar ao Perfil
            </a>
            <span class="fw-semibold text-dark small">
                <i class="bi bi-patch-check-fill text-success me-1"></i> Certificado Autêntico &middot; Código: <strong>@Model.Certificado.CodigoAutenticidade</strong>
            </span>
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-primary btn-sm rounded-pill px-4 fw-semibold shadow-sm" onclick="window.print()">
                <i class="bi bi-printer-fill me-1"></i> Imprimir / Salvar como PDF
            </button>
        </div>
    </div>

    <!-- Folha do Certificado -->
    <div class="certificate-sheet">
        <div class="border-outer">
            <div class="border-inner">

                <!-- Topo -->
                <div class="cert-header">
                    <div class="cert-institution">EJL Academy</div>
                    <div class="cert-sub-institution">Ambiente Virtual de Aprendizagem &middot; Formação Profissional</div>
                    <div class="cert-title">Certificado de Conclusão</div>
                </div>

                <!-- Conteúdo Central -->
                <div class="cert-body">
                    <div class="cert-text-intro">Certificamos com mérito e honra que</div>
                    <div class="cert-student-name">@(Model.Aluno.NomeCompleto ?? Model.Aluno.UserName)</div>
                    <div class="cert-description">
                        concluiu com êxito todos os módulos e requisitos acadêmicos da trilha de aprendizado
                        <div class="cert-course-name my-2">@Model.Curso.Titulo</div>
                        cumprindo satisfatoriamente a carga horária total de <strong>@Model.Certificado.CargaHorariaHoras horas</strong> de atividades teórico-práticas.
                    </div>
                </div>

                <!-- Rodapé com Assinaturas e Autenticidade -->
                <div class="cert-footer">
                    <!-- Código e Validação -->
                    <div class="verification-info">
                        <div><strong>Código de Autenticidade:</strong> @Model.Certificado.CodigoAutenticidade</div>
                        <div><strong>Data de Emissão:</strong> @Model.Certificado.DataEmissao.ToString("dd 'de' MMMM 'de' yyyy", new System.Globalization.CultureInfo("pt-BR"))</div>
                        <div class="text-muted">Validação pública: ejlacademy.com.br/Certificados/Validar</div>
                    </div>

                    <!-- Selo Dourado -->
                    <div class="seal-badge">
                        <i class="bi bi-award-fill fs-4"></i>
                        <span style="font-size: 0.55rem; font-weight: 800; text-transform: uppercase;">Oficial</span>
                    </div>

                    <!-- Assinatura Direção -->
                    <div class="signature-box">
                        <div class="signature-hand">Eduardo J. L.</div>
                        <div class="signature-line">
                            Diretoria Acadêmica<br />
                            <span class="text-muted" style="font-size: 0.65rem;">EJLAcademy Institucional</span>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

</body>
</html>
