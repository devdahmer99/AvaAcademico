@page
@model AvaAcademico.Pages.Certificados.ValidarModel
@{
    ViewData["Title"] = "Validação Pública de Certificados";
}

<div class="container py-4" style="max-width: 800px;">
    <div class="text-center mb-5">
        <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-inline-flex align-items-center justify-content-center mb-3" style="width: 70px; height: 70px;">
            <i class="bi bi-shield-check fs-1"></i>
        </div>
        <h2 class="fw-bold text-dark mb-1">Validação de Certificados Oficiais</h2>
        <p class="text-muted">Consulte a autenticidade e validade de certificados emitidos pela EJLAcademy.</p>
    </div>

    <!-- Campo de Busca -->
    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
        <form method="get">
            <label class="form-label fw-semibold text-secondary small">Código de Autenticidade</label>
            <div class="input-group input-group-lg">
                <input type="text" asp-for="Codigo" class="form-control" placeholder="Ex: EJL-2026-AB12CD34" autofocus required />
                <button type="submit" class="btn btn-primary px-4 fw-semibold">
                    <i class="bi bi-search me-1"></i> Validar
                </button>
            </div>
            <span class="text-muted small mt-1 d-block">O código de autenticidade pode ser localizado no rodapé do certificado emitido.</span>
        </form>
    </div>

    <!-- Resultado -->
    @if (Model.Pesquisou)
    {
        @if (Model.CertificadoEncontrado != null)
        {
            <div class="card border-success border-2 shadow-sm rounded-4 p-4 bg-white">
                <div class="d-flex align-items-center gap-3 mb-3 text-success">
                    <i class="bi bi-check-circle-fill fs-2"></i>
                    <div>
                        <h4 class="fw-bold text-success mb-0">Certificado Autêntico e Válido</h4>
                        <span class="text-muted small">Registrado na base de dados oficial da EJLAcademy</span>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-borderless align-middle mb-0">
                        <tbody>
                            <tr>
                                <th class="text-muted ps-0" style="width: 35%;">Aluno(a):</th>
                                <td class="fw-bold text-dark fs-5">@(Model.CertificadoEncontrado.Usuario.NomeCompleto ?? Model.CertificadoEncontrado.Usuario.UserName)</td>
                            </tr>
                            <tr>
                                <th class="text-muted ps-0">Curso / Trilha:</th>
                                <td class="fw-bold text-primary">@Model.CertificadoEncontrado.Curso.Titulo</td>
                            </tr>
                            <tr>
                                <th class="text-muted ps-0">Carga Horária:</th>
                                <td class="fw-semibold text-dark">@Model.CertificadoEncontrado.CargaHorariaHoras Horas</td>
                            </tr>
                            <tr>
                                <th class="text-muted ps-0">Data de Emissão:</th>
                                <td class="text-dark">@Model.CertificadoEncontrado.DataEmissao.ToString("dd/MM/yyyy 'às' HH:mm:ss")</td>
                            </tr>
                            <tr>
                                <th class="text-muted ps-0">Código Hash:</th>
                                <td class="font-monospace fw-bold text-dark">@Model.CertificadoEncontrado.CodigoAutenticidade</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-danger border-0 shadow-sm rounded-4 p-4 text-center">
                <i class="bi bi-x-circle-fill fs-1 text-danger mb-2 d-block"></i>
                <h5 class="fw-bold text-danger">Certificado Não Encontrado</h5>
                <p class="text-muted small mb-0">
                    O código <strong>@Model.Codigo</strong> não corresponde a nenhum certificado emitido em nosso sistema. Verifique a digitação e tente novamente.
                </p>
            </div>
        }
    }
</div>
