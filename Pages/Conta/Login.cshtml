@page
@model AvaAcademico.Pages.Conta.LoginModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Entrar - EJLAcademy</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body, html {
            height: 100%;
            font-family: 'Inter', sans-serif;
            background-color: #fff;
        }

        .split-screen {
            display: flex;
            height: 100vh;
            width: 100vw;
            overflow: hidden;
        }

        .form-side {
            flex: 1;
            display: flex;
            flex-direction: column;
            justify-content: center;
            padding: 4rem;
            background: #fff;
            z-index: 2;
        }

        .brand-title {
            font-size: 1.8rem;
            font-weight: 700;
            color: #111;
            letter-spacing: -0.5px;
            margin-bottom: 2.5rem;
        }

            .brand-title span {
                color: #0d6efd;
            }

        .visual-side {
            flex: 1.2;
            background: linear-gradient(135deg, #0d6efd 0%, #004ba0 100%);
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }
            /* Efeito de formas arredondadas abstratas no painel azul igual à referência */
            .visual-side::before {
                content: '';
                position: absolute;
                width: 800px;
                height: 800px;
                background: rgba(255, 255, 255, 0.05);
                border-radius: 50%;
                bottom: -300px;
                right: -200px;
            }

        .form-control {
            background-color: #f8f9fa;
            border: 1px solid #e5e7eb;
            padding: 0.75rem 1rem;
            font-size: 0.95rem;
            border-radius: 8px;
        }

            .form-control:focus {
                background-color: #fff;
                border-color: #0d6efd;
                box-shadow: 0 0 0 4px rgba(13, 110, 253, 0.1);
            }

        .btn-login {
            background-color: #93c5fd;
            border: none;
            color: #1e3a8a;
            font-weight: 600;
            padding: 0.75rem;
            border-radius: 8px;
            transition: background 0.2s;
        }

            .btn-login:hover {
                background-color: #60a5fa;
                color: #fff;
            }
        @@media (max-width: 992px) {
            .visual-side {
                display: none;
            }

            .form-side {
                padding: 2rem;
            }
        }
    </style>
</head>
<body>

    <div class="split-screen">
        <!-- Lado Esquerdo: Formulário -->
        <div class="form-side">
            <div style="max-width: 400px; width: 100%; margin: 0 auto;">

                <div class="brand-title">
                    EJL<span>Academy</span>
                </div>

                <h3 class="fw-bold text-dark mb-2" style="font-size: 1.5rem;">Olá, boas-vindas!</h3>
                <p class="text-muted mb-4" style="font-size: 0.9rem;">
                    Acesso ao Ambiente Virtual de Aprendizagem.
                </p>

                <form method="post">
                    <a class="btn btn-outline-primary w-100 mb-3 shadow-sm" href="/Conta/ExternalLogin?provider=Google&amp;returnUrl=/">
                        <i class="bi bi-google me-2"></i>Entrar com Google
                    </a>

                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Usuario" class="form-label text-secondary fw-semibold" style="font-size: 0.85rem;">Login / E-mail</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted" style="border-radius: 8px 0 0 8px;"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Usuario" type="text" class="form-control border-start-0 ps-0" placeholder="E-mail ou usuário" style="border-radius: 0 8px 8px 0;" />
                        </div>
                        <span asp-validation-for="Usuario" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Senha" class="form-label text-secondary fw-semibold" style="font-size: 0.85rem;">Senha</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted" style="border-radius: 8px 0 0 8px;"><i class="bi bi-lock"></i></span>
                            <input asp-for="Senha" type="password" id="inputSenha" class="form-control border-start-0 border-end-0 ps-0" placeholder="Digite sua senha" />
                            <span class="input-group-text bg-light border-start-0 text-muted" style="border-radius: 0 8px 8px 0; cursor: pointer;" onclick="toggleSenha()">
                                <i class="bi bi-eye-slash" id="iconeOlho"></i>
                            </span>
                        </div>
                        <span asp-validation-for="Senha" class="text-danger small"></span>
                    </div>

                    <div class="form-check mb-4">
                        <input asp-for="LembrarMe" class="form-check-input" type="checkbox" id="lembrarMe" />
                        <label class="form-check-label text-secondary fw-semibold" for="lembrarMe" style="font-size: 0.85rem;">
                            Lembrar-me
                        </label>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-4" style="font-size: 0.85rem;">
                        <a href="#" class="text-decoration-none text-primary fw-semibold">Primeiro acesso</a>
                        <a href="#" class="text-decoration-none text-primary fw-semibold">Esqueceu a sua senha?</a>
                    </div>

                    <button type="submit" class="btn btn-login w-100 shadow-sm">Entrar na plataforma</button>
                </form>

            </div>
        </div>

        <!-- Lado Direito: Painel Visual com Identidade Azul Original -->
        <div class="visual-side">
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function toggleSenha() {
            const input = document.getElementById('inputSenha');
            const icon = document.getElementById('iconeOlho');
            if (input.type === 'password') {
                input.type = 'text';
                icon.className = 'bi bi-eye';
            } else {
                input.type = 'password';
                icon.className = 'bi bi-eye-slash';
            }
        }
    </script>
</body>
</html>
