@page
@model AvaAcademico.Pages.Modulos.CriarModel

<div class="mb-4">
    <div class="d-flex justify-content-between align-items-center mb-1">
        <h2 class="fw-bold text-dark mb-0" style="font-size: 1.5rem;">Cadastrar Módulo</h2>
        @if (Model.CursoId.HasValue && Model.CursoId.Value > 0)
        {
            <a href="/Cursos/Detalhes?id=@Model.CursoId" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                <i class="bi bi-arrow-left me-1"></i> Ver Curso
            </a>
        }
    </div>
    <p class="text-muted mb-0" style="font-size: 0.9rem;">Organize seu curso dividindo-o em módulos sequenciais.</p>
</div>

@if (TempData["MensagemSucesso"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert" style="max-width: 800px;">
        <i class="bi bi-check-circle-fill me-2"></i>
        <span>@TempData["MensagemSucesso"]</span>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card border-0 shadow-sm rounded-3 p-4 bg-white" style="max-width: 800px;">
    <form method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 rounded-3 small py-2 mb-3"></div>

        <div class="mb-3">
            <label class="form-label fw-semibold text-secondary" style="font-size: 0.85rem;">Vincular ao Curso</label>
            <select asp-for="Modulo.CursoId" class="form-select" id="selectCurso" required>
                <option value="">Selecione o curso...</option>
                @foreach (var curso in Model.CursosDisponiveis)
                {
                    <option value="@curso.Id">@curso.Titulo</option>
                }
            </select>
            <span asp-validation-for="Modulo.CursoId" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold text-secondary" style="font-size: 0.85rem;">Título do Módulo</label>
            <input type="text" asp-for="Modulo.Titulo" class="form-control" placeholder="Ex: Módulo 1 - Fundamentos" autofocus required />
            <span asp-validation-for="Modulo.Titulo" class="text-danger small"></span>
        </div>

        <div class="mb-4">
            <label class="form-label fw-semibold text-secondary" style="font-size: 0.85rem;">
                Ordem de Exibição (Número)
                <span class="text-muted fw-normal ms-1">(calculado automaticamente)</span>
            </label>
            <div class="input-group">
                <input type="number" asp-for="Modulo.Ordem" class="form-control" id="inputOrdem" min="1" required />
                <span class="input-group-text bg-light text-muted" id="loadingOrdem" style="display: none;">
                    <span class="spinner-border spinner-border-sm" role="status"></span>
                </span>
            </div>
            <span asp-validation-for="Modulo.Ordem" class="text-danger small"></span>
        </div>

        <div class="d-flex align-items-center gap-2">
            <button type="submit" class="btn btn-primary px-4 py-2 fw-semibold" style="font-size: 0.9rem;">
                <i class="bi bi-plus-circle me-1"></i> Salvar Módulo
            </button>
            <a href="/" class="btn btn-light px-3 py-2 text-muted fw-medium" style="font-size: 0.9rem;">Cancelar</a>
        </div>
    </form>
</div>

<script>
    const selectCurso = document.getElementById("selectCurso");
    const inputOrdem = document.getElementById("inputOrdem");
    const loadingOrdem = document.getElementById("loadingOrdem");

    async function atualizarOrdemCurso(cursoId) {
        if (!cursoId) return;
        if (loadingOrdem) loadingOrdem.style.display = 'inline-block';

        try {
            let url = `?handler=UltimaOrdem&cursoId=${cursoId}`;
            let response = await fetch(url);
            if (response.ok) {
                let data = await response.json();
                inputOrdem.value = data.proximaOrdem;
            }
        } catch (e) {
            console.error("Erro ao carregar ordem:", e);
        } finally {
            if (loadingOrdem) loadingOrdem.style.display = 'none';
        }
    }

    selectCurso.addEventListener("change", function () {
        atualizarOrdemCurso(this.value);
    });

    document.addEventListener("DOMContentLoaded", function () {
        if (selectCurso.value && (!inputOrdem.value || inputOrdem.value === "0")) {
            atualizarOrdemCurso(selectCurso.value);
        }
    });
</script>