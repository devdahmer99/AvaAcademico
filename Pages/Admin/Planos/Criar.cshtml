@page
@model AvaAcademico.Pages.Admin.Planos.CriarModel
@{
    ViewData["Title"] = "Criar Novo Plano";
}

<div class="mb-4">
    <div class="d-flex justify-content-between align-items-center mb-1">
        <h2 class="fw-bold text-dark mb-0" style="font-size: 1.5rem;">Cadastrar Novo Plano</h2>
        <a href="/Admin/Planos" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            <i class="bi bi-arrow-left me-1"></i> Voltar aos Planos
        </a>
    </div>
    <p class="text-muted mb-0" style="font-size: 0.9rem;">Defina valores, periodicidade e benefícios para os alunos.</p>
</div>

<div class="card border-0 shadow-sm rounded-4 bg-white p-4" style="max-width: 750px;">
    <form method="post">
        <div class="mb-3">
            <label class="form-label fw-semibold text-secondary small">Nome do Plano</label>
            <input type="text" asp-for="Plano.Nome" class="form-control" placeholder="Ex: Plano Pro Anual" autofocus required />
            <span asp-validation-for="Plano.Nome" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold text-secondary small">Descrição Resumida</label>
            <input type="text" asp-for="Plano.Descricao" class="form-control" placeholder="Ex: Acesso irrestrito a todas as trilhas e materiais" required />
            <span asp-validation-for="Plano.Descricao" class="text-danger small"></span>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <label class="form-label fw-semibold text-secondary small">Preço (R$)</label>
                <div class="input-group">
                    <span class="input-group-text bg-light">R$</span>
                    <input type="number" step="0.01" asp-for="Plano.Preco" class="form-control" placeholder="49.90" required />
                </div>
                <span asp-validation-for="Plano.Preco" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label class="form-label fw-semibold text-secondary small">Periodicidade (Meses de Acesso)</label>
                <select asp-for="Plano.IntervaloMeses" class="form-select">
                    <option value="1">1 Mês (Mensal)</option>
                    <option value="3">3 Meses (Trimestral)</option>
                    <option value="6">6 Meses (Semestral)</option>
                    <option value="12">12 Meses (Anual)</option>
                    <option value="24">24 Meses (Bienal)</option>
                </select>
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold text-secondary small">Benefícios (Um por linha)</label>
            <textarea asp-for="Plano.Beneficios" class="form-control" rows="4" placeholder="Acesso a todos os cursos&#10;Emissão de certificados ilimitados&#10;Acesso à biblioteca virtual&#10;Fórum com instrutores"></textarea>
            <span class="text-muted small">Cada linha digitada será exibida como um item com checkmark na vitrine.</span>
        </div>

        <div class="d-flex gap-4 mb-4 pt-2">
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" asp-for="Plano.Destaque" id="switchDestaque" />
                <label class="form-check-label fw-semibold text-secondary small" for="switchDestaque">
                    Destacar como "Mais Popular"
                </label>
            </div>

            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" asp-for="Plano.Ativo" id="switchAtivo" checked />
                <label class="form-check-label fw-semibold text-secondary small" for="switchAtivo">
                    Plano Ativo e Visível
                </label>
            </div>
        </div>

        <div class="d-flex align-items-center gap-2">
            <button type="submit" class="btn btn-primary px-4 py-2 fw-semibold rounded-pill">
                <i class="bi bi-plus-circle me-1"></i> Salvar Plano
            </button>
            <a href="/Admin/Planos" class="btn btn-light px-3 py-2 text-muted fw-medium rounded-pill">Cancelar</a>
        </div>
    </form>
</div>
