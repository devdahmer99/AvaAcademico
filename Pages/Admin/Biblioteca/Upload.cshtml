@page
@model AvaAcademico.Pages.Admin.Biblioteca.UploadModel
@{
    ViewData["Title"] = "Adicionar Livro / PDF";
}

<div class="mb-4">
    <div class="d-flex justify-content-between align-items-center mb-1">
        <h2 class="fw-bold text-dark mb-0" style="font-size: 1.5rem;">Cadastrar Livro ou Material em PDF</h2>
        <a href="/Admin/Biblioteca" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            <i class="bi bi-arrow-left me-1"></i> Voltar à Biblioteca
        </a>
    </div>
    <p class="text-muted mb-0" style="font-size: 0.9rem;">Envie arquivos PDF de apostilas, livros e materiais didáticos.</p>
</div>

<div class="card border-0 shadow-sm rounded-4 bg-white p-4" style="max-width: 750px;">
    <form method="post" enctype="multipart/form-data">
        <div class="mb-3">
            <label class="form-label fw-semibold text-secondary small">Título da Obra / Apostila</label>
            <input type="text" asp-for="InputLivro.Titulo" class="form-control" placeholder="Ex: Manual Completo de Segurança Defensiva" autofocus required />
            <span asp-validation-for="InputLivro.Titulo" class="text-danger small"></span>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-md-7">
                <label class="form-label fw-semibold text-secondary small">Autor(es) / Organização</label>
                <input type="text" asp-for="InputLivro.Autor" class="form-control" placeholder="Ex: Prof. Eduardo Silva" required />
                <span asp-validation-for="InputLivro.Autor" class="text-danger small"></span>
            </div>

            <div class="col-md-5">
                <label class="form-label fw-semibold text-secondary small">Categoria</label>
                <input type="text" asp-for="InputLivro.Categoria" class="form-control" placeholder="Ex: Cibersegurança" list="listaCategorias" required />
                <datalist id="listaCategorias">
                    <option value="Tecnologia"></option>
                    <option value="Cibersegurança"></option>
                    <option value="Programação"></option>
                    <option value="Redes & Infraestrutura"></option>
                    <option value="Gestão de TI"></option>
                    <option value="Geral"></option>
                </datalist>
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold text-secondary small">Número Estimado de Páginas</label>
            <input type="number" asp-for="InputLivro.NumeroPaginas" class="form-control" placeholder="Ex: 150" />
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold text-secondary small">Descrição / Sinopse</label>
            <textarea asp-for="InputLivro.Descricao" class="form-control" rows="3" placeholder="Breve resumo sobre o conteúdo abordado neste material..."></textarea>
        </div>

        <div class="mb-4">
            <label class="form-label fw-semibold text-secondary small">Arquivo PDF do Livro</label>
            <input type="file" asp-for="ArquivoPdf" class="form-control" accept="application/pdf" required />
            <span class="text-muted small">Apenas arquivos no formato .PDF são aceitos.</span>
        </div>

        <div class="d-flex align-items-center gap-2">
            <button type="submit" class="btn btn-primary px-4 py-2 fw-semibold rounded-pill">
                <i class="bi bi-cloud-upload-fill me-1"></i> Salvar e Publicar
            </button>
            <a href="/Admin/Biblioteca" class="btn btn-light px-3 py-2 text-muted fw-medium rounded-pill">Cancelar</a>
        </div>
    </form>
</div>
