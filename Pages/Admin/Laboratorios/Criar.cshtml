@page
@model AvaAcademico.Pages.Admin.Laboratorios.CriarModel
@{
    ViewData["Title"] = "Novo Laboratório Hands-on (Docker)";
}

<div class="mb-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <a href="/Admin/Laboratorios" class="text-decoration-none text-muted small fw-semibold">
            <i class="bi bi-arrow-left me-1"></i> Voltar aos Laboratórios
        </a>
        <h2 class="fw-bold text-dark mt-1 mb-0" style="font-size: 1.5rem;">
            <i class="bi bi-plus-circle text-primary me-2"></i>Cadastrar Novo Laboratório Virtual
        </h2>
    </div>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <!-- Botões de Predefinições Rápidas (Presets) -->
                <div class="mb-4 p-3 bg-light rounded-3 border">
                    <label class="form-label fw-bold text-dark small mb-2">
                        <i class="bi bi-lightning-charge-fill text-warning me-1"></i> Modelos Rápidos de Laboratório:
                    </label>
                    <div class="d-flex flex-wrap gap-2">
                        <button type="button" class="btn btn-outline-primary btn-sm rounded-pill" onclick="aplicarPreset('Web Hacking com DVWA', 'vulnerables/web-dvwa', 80, 'DESEC{dvwa_sql_injection_ok}')">
                            <i class="bi bi-browser-chrome me-1"></i> DVWA (Web Hacking)
                        </button>
                        <button type="button" class="btn btn-outline-primary btn-sm rounded-pill" onclick="aplicarPreset('OWASP Juice Shop', 'bkimminich/juice-shop', 3000, 'DESEC{juice_shop_flag}')">
                            <i class="bi bi-cup-straw me-1"></i> OWASP Juice Shop
                        </button>
                        <button type="button" class="btn btn-outline-primary btn-sm rounded-pill" onclick="aplicarPreset('Alvo SSH para Brute Force', 'rastasheep/ubuntu-sshd', 22, 'DESEC{ssh_bruteforced}')">
                            <i class="bi bi-terminal me-1"></i> Alvo SSH (Hydra)
                        </button>
                        <button type="button" class="btn btn-outline-primary btn-sm rounded-pill" onclick="aplicarPreset('Terminal Linux Interativo Web', 'tsl0922/ttyd:alpine', 7681, 'DESEC{terminal_linux_master}')">
                            <i class="bi bi-terminal-fill me-1"></i> Terminal Linux (ttyd)
                        </button>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.Titulo" class="form-label fw-semibold text-dark">Título do Laboratório</label>
                    <input asp-for="Input.Titulo" class="form-control" id="inputTitulo" placeholder="Ex: Laboratório de Scanning e Enumeração com Nmap" required />
                    <span asp-validation-for="Input.Titulo" class="text-danger small"></span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-8">
                        <label asp-for="Input.ImagemDocker" class="form-label fw-semibold text-dark">Imagem Docker (Docker Hub)</label>
                        <input asp-for="Input.ImagemDocker" class="form-control font-monospace" id="inputImagem" placeholder="Ex: vulnerables/web-dvwa ou bkimminich/juice-shop" required />
                        <span asp-validation-for="Input.ImagemDocker" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Input.PortaPadraoContainer" class="form-label fw-semibold text-dark">Porta do Container</label>
                        <input asp-for="Input.PortaPadraoContainer" type="number" class="form-control" id="inputPorta" value="80" required />
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="Input.Flag" class="form-label fw-semibold text-dark">Flag do Desafio CTF (Opcional)</label>
                        <input asp-for="Input.Flag" class="form-control font-monospace" id="inputFlag" placeholder="Ex: DESEC{sua_flag_aqui}" />
                        <span class="text-muted" style="font-size: 0.75rem;">O aluno digita essa flag para comprovar que concluiu o desafio.</span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="Input.Pontos" class="form-label fw-semibold text-dark">Pontuação (XP)</label>
                        <input asp-for="Input.Pontos" type="number" class="form-control" value="100" />
                    </div>
                    <div class="col-md-3">
                        <label asp-for="Input.TempoLimiteMinutos" class="form-label fw-semibold text-dark">Tempo Limite (Minutos)</label>
                        <input asp-for="Input.TempoLimiteMinutos" type="number" class="form-control" value="60" />
                    </div>
                </div>

                <!-- Vínculo com Módulo ou Aula -->
                <div class="mb-3">
                    <label class="form-label fw-semibold text-dark">Vincular a uma Aula (Opcional)</label>
                    <select asp-for="Input.AulaId" class="form-select">
                        <option value="">-- Não vincular a aula específica (Lab Avulso) --</option>
                        @foreach (var curso in Model.CursosComModulosEAulas)
                        {
                            <optgroup label="Curso: @curso.Titulo">
                                @foreach (var modulo in curso.Modulos)
                                {
                                    @foreach (var aula in modulo.Aulas)
                                    {
                                        <option value="@aula.Id">@modulo.Titulo > @aula.Titulo</option>
                                    }
                                }
                            </optgroup>
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.Descricao" class="form-label fw-semibold text-dark">Instruções e Objetivos para o Aluno</label>
                    <textarea asp-for="Input.Descricao" class="form-control" rows="4" placeholder="Descreva o que o aluno deve fazer neste laboratório... Ex: 'Realize uma varredura de portas no IP alvo, explore a falha de SQL Injection na página de login e capture a chave de administrador.'"></textarea>
                </div>

                <div class="mb-4">
                    <label asp-for="Input.ParametrosAmbiente" class="form-label fw-semibold text-dark">Variáveis de Ambiente Adicionais (Opcional)</label>
                    <input asp-for="Input.ParametrosAmbiente" class="form-control font-monospace" placeholder="VAR1=valor;VAR2=valor" />
                    <span class="text-muted" style="font-size: 0.75rem;">Separadas por ponto e vírgula (;).</span>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a href="/Admin/Laboratorios" class="btn btn-light rounded-pill px-4">Cancelar</a>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold">
                        <i class="bi bi-check-lg me-1"></i> Salvar Laboratório
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Dicas Laterais -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
            <h6 class="fw-bold text-dark mb-3">
                <i class="bi bi-info-circle-fill text-primary me-2"></i>Como Funcionam os Laboratórios
            </h6>
            <ul class="text-secondary small ps-3 mb-0" style="line-height: 1.8;">
                <li>O container só é iniciado quando o aluno clica no botão <strong>"Iniciar Laboratório"</strong> na aula.</li>
                <li>Cada aluno recebe uma porta TCP exclusiva no host (ex: 9001, 9002), evitando qualquer conflito.</li>
                <li>O tempo limite padrão (ex: 60 min) desliga o container automaticamente caso o aluno esqueça aberto, liberando a RAM.</li>
                <li>Ao submeter a Flag correta, o aluno conquista os pontos e a aula/lab fica marcada como <strong>Resolvida</strong>.</li>
            </ul>
        </div>
    </div>
</div>

<script>
    function aplicarPreset(titulo, imagem, porta, flag) {
        document.getElementById('inputTitulo').value = titulo;
        document.getElementById('inputImagem').value = imagem;
        document.getElementById('inputPorta').value = porta;
        document.getElementById('inputFlag').value = flag;
    }
</script>

