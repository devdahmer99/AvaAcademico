@page
@model AvaAcademico.Pages.Cursos.DetalhesModel

<div class="mb-4">
    <a href="/" class="text-decoration-none text-muted fw-semibold" style="font-size: 0.9rem;">
        <i class="bi bi-arrow-left me-1"></i> Voltar para os Cursos
    </a>
</div>

@if (TempData["MensagemSucesso"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["MensagemSucesso"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["MensagemErro"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["MensagemErro"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Cabeçalho do Curso -->
<div class="bg-white border border-light p-4 rounded-4 shadow-sm mb-4">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-3">
        <div>
            <span class="badge bg-primary bg-opacity-10 text-primary mb-2 px-3 py-1 rounded-pill fw-semibold" style="font-size: 0.75rem;">Trilha de Aprendizado</span>
            <h1 class="fw-bold text-dark mb-2" style="font-size: 1.75rem;">@Model.Curso.Titulo</h1>
            <p class="text-muted mb-0" style="font-size: 0.95rem; max-width: 800px;">@Model.Curso.Descricao</p>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <a href="/Cursos/Forum?cursoId=@Model.Curso.Id" class="btn btn-outline-secondary btn-sm rounded-pill px-3 fw-semibold">
                <i class="bi bi-chat-left-dots-fill me-1 text-primary"></i> Fórum do Curso
            </a>

            @if (User.IsInRole("Administrador"))
            {
                <a href="/Modulos/Criar?cursoId=@Model.Curso.Id" class="btn btn-outline-primary btn-sm rounded-pill px-3 fw-semibold">
                    <i class="bi bi-folder-plus me-1"></i> + Novo Módulo
                </a>
            }
        </div>
    </div>

    <!-- Barra de Progresso ou Botão de Matrícula -->
    @if (Model.IsMatriculado)
    {
        <div class="p-3 bg-light rounded-3 border mt-3">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="small fw-semibold text-secondary">Seu Progresso Nesta Trilha:</span>
                <span class="small fw-bold text-primary">@Model.AulasConcluidasIds.Count de @Model.Curso.Modulos.SelectMany(m => m.Aulas).Count() aulas (@Model.PercentualProgresso%)</span>
            </div>
            <div class="progress" style="height: 8px;">
                <div class="progress-bar bg-success" role="progressbar" style="width: @Model.PercentualProgresso%"></div>
            </div>
        </div>

        @if (Model.Concluido100PorCento)
        {
            <div class="alert alert-warning border-0 shadow-sm rounded-3 p-3 mt-3 d-flex justify-content-between align-items-center flex-wrap gap-2 mb-0">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-trophy-fill text-warning fs-4"></i>
                    <span class="fw-bold text-dark small">Parabéns! Você completou 100% deste curso.</span>
                </div>
                <a href="/Certificados/Emitir?cursoId=@Model.Curso.Id" class="btn btn-primary btn-sm rounded-pill px-3 fw-bold">
                    <i class="bi bi-award-fill me-1"></i> Emitir Certificado
                </a>
            </div>
        }
    }
    else
    {
        <div class="alert alert-info border-0 shadow-sm rounded-3 p-3 mt-3 d-flex justify-content-between align-items-center flex-wrap gap-2 mb-0">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-info-circle-fill text-primary fs-5"></i>
                <span class="text-dark small">Você ainda não está matriculado neste curso. Matricule-se para iniciar e acompanhar suas aulas.</span>
            </div>
            <form method="post" asp-page-handler="Matricular" asp-route-id="@Model.Curso.Id">
                <button type="submit" class="btn btn-primary btn-sm rounded-pill px-4 fw-bold shadow-sm">
                    <i class="bi bi-journal-plus me-1"></i> Matricular-se Agora
                </button>
            </form>
        </div>
    }
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="fw-bold text-dark mb-0" style="font-size: 1.2rem;">Conteúdo Programático</h4>
</div>

<!-- Acordeão de Módulos -->
<div class="accordion shadow-sm rounded-4 overflow-hidden border-0" id="accordionDetalhesCurso">
    @{
        var modulosOrdenados = Model.Curso.Modulos.OrderBy(m => m.Ordem).ToList();
        int index = 0;

        foreach (var modulo in modulosOrdenados)
        {
            string collapseId = "moduloCollapse" + index;
            bool isOpen = index == 0;

            <div class="accordion-item border-0 border-bottom">
                <h2 class="accordion-header">
                    <button class="accordion-button @(isOpen ? "" : "collapsed") bg-white fw-bold text-dark py-3 px-4 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#@collapseId" style="font-size: 1.05rem;">
                        <div class="d-flex justify-content-between align-items-center w-100 me-3">
                            <span><span class="text-primary me-2">Módulo @modulo.Ordem:</span> @modulo.Titulo</span>
                            <span class="text-muted fw-normal" style="font-size: 0.85rem;">@modulo.Aulas.Count() aulas</span>
                        </div>
                    </button>
                </h2>

                <div id="@collapseId" class="accordion-collapse collapse @(isOpen ? "show" : "")" data-bs-parent="#accordionDetalhesCurso">
                    <div class="accordion-body p-0">
                        <div class="list-group list-group-flush">
                            @if (!modulo.Aulas.Any())
                            {
                                <div class="list-group-item py-3 px-4 text-muted fst-italic" style="font-size: 0.9rem;">
                                    Nenhuma aula cadastrada neste módulo ainda.
                                </div>
                            }
                            else
                            {
                                @foreach (var aula in modulo.Aulas.OrderBy(a => a.Ordem))
                                {
                                    bool isConcluida = Model.AulasConcluidasIds.Contains(aula.Id);

                                    <a href="/Aulas/Assistir?id=@aula.Id" class="list-group-item list-group-item-action py-3 px-4 d-flex justify-content-between align-items-center border-light">
                                        <div class="d-flex align-items-center">
                                            <div class="rounded-circle @(isConcluida ? "bg-success bg-opacity-10 text-success" : "bg-light text-primary") d-flex align-items-center justify-content-center me-3 fw-bold" style="width: 32px; height: 32px; font-size: 0.85rem;">
                                                @if (isConcluida)
                                                {
                                                    <i class="bi bi-check-lg"></i>
                                                }
                                                else
                                                {
                                                    @aula.Ordem
                                                }
                                            </div>
                                            <span class="fw-medium text-dark" style="font-size: 0.95rem;">@aula.Titulo</span>
                                        </div>

                                        <div class="d-flex align-items-center gap-2">
                                            @if (isConcluida)
                                            {
                                                <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-1" style="font-size: 0.75rem;">Concluída</span>
                                            }
                                            <span class="text-primary fw-semibold" style="font-size: 0.85rem;">Assistir <i class="bi bi-chevron-right ms-1"></i></span>
                                        </div>
                                    </a>
                                }
                            }
                        </div>
                        
                        <!-- Barra de ações rápidas para Administrador -->
                        @if (User.IsInRole("Administrador"))
                        {
                            <div class="p-3 bg-light bg-opacity-75 border-top d-flex justify-content-end align-items-center gap-2">
                                <a href="/Aulas/Criar?moduloId=@modulo.Id" class="btn btn-outline-primary btn-sm rounded-pill px-3 fw-medium">
                                    <i class="bi bi-plus-lg me-1"></i> + Nova Aula
                                </a>
                                <a href="/Aulas/UploadEmMassa?moduloId=@modulo.Id" class="btn btn-primary btn-sm rounded-pill px-3 fw-medium">
                                    <i class="bi bi-cloud-arrow-up-fill me-1"></i> ⚡ Upload em Massa
                                </a>
                            </div>
                        }
                    </div>
                </div>
            </div>
            index++;
        }
    }
</div>