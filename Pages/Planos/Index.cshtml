@page
@model AvaAcademico.Pages.Planos.IndexModel
@{
    ViewData["Title"] = "Planos de Acesso";
}

<div class="text-center py-4 mb-4">
    <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-1 rounded-pill fw-semibold mb-2">Acesso Ilimitado</span>
    <h1 class="fw-bold text-dark mb-2" style="font-size: 2rem;">Escolha o Plano Ideal para Sua Formação</h1>
    <p class="text-muted mx-auto" style="max-width: 650px; font-size: 1rem;">
        Tenha acesso irrestrito a todas as trilhas acadêmicas, fóruns com instrutores, biblioteca virtual de livros e emissão de certificados oficiais.
    </p>

    @if (Model.AssinaturaAtual != null)
    {
        <div class="alert alert-success d-inline-flex align-items-center gap-2 px-4 py-2 rounded-pill shadow-sm border-0 mt-2">
            <i class="bi bi-patch-check-fill fs-5"></i>
            <span>Você possui o <strong>@Model.AssinaturaAtual.Plano.Nome</strong> ativo até @(Model.AssinaturaAtual.DataFim?.ToString("dd/MM/yyyy") ?? "Acesso Ilimitado")!</span>
        </div>
    }
</div>

<div class="row row-cols-1 row-cols-md-3 g-4 align-items-stretch" style="max-width: 1100px; margin: 0 auto;">
    @foreach (var plano in Model.Planos)
    {
        bool isCurrentPlan = Model.AssinaturaAtual?.PlanoId == plano.Id;
        string cardBorder = plano.Destaque ? "border-primary border-2 shadow" : "border-0 shadow-sm";

        <div class="col d-flex">
            <div class="card @cardBorder rounded-4 bg-white p-4 w-100 d-flex flex-column justify-content-between position-relative">
                @if (plano.Destaque)
                {
                    <div class="position-absolute top-0 start-50 translate-middle">
                        <span class="badge bg-primary px-3 py-1 rounded-pill fw-bold shadow-sm" style="font-size: 0.75rem; letter-spacing: 0.5px;">
                            MAIS POPULAR &bull; MELHOR CUSTO
                        </span>
                    </div>
                }

                <div>
                    <h4 class="fw-bold text-dark mb-1">@plano.Nome</h4>
                    <p class="text-muted small mb-4">@plano.Descricao</p>

                    <div class="mb-4">
                        <span class="text-muted small align-top">R$</span>
                        <span class="fw-bold text-dark" style="font-size: 2.5rem; letter-spacing: -1px;">@plano.Preco.ToString("N2")</span>
                        <span class="text-muted small">/@(plano.IntervaloMeses == 1 ? "mês" : plano.IntervaloMeses == 12 ? "ano" : $"{plano.IntervaloMeses} meses")</span>
                    </div>

                    <div class="border-top pt-3 mb-4">
                        <div class="fw-semibold text-secondary small mb-2 text-uppercase" style="letter-spacing: 0.5px;">Benefícios Inclusos:</div>
                        <ul class="list-unstyled mb-0 d-flex flex-column gap-2">
                            @if (!string.IsNullOrEmpty(plano.Beneficios))
                            {
                                var itens = plano.Beneficios.Split('\n', StringSplitOptions.RemoveEmptyEntries);
                                foreach (var item in itens)
                                {
                                    <li class="d-flex align-items-start gap-2 small text-secondary">
                                        <i class="bi bi-check2-circle text-success fs-6 mt-0"></i>
                                        <span>@item.Trim()</span>
                                    </li>
                                }
                            }
                            else
                            {
                                <li class="d-flex align-items-start gap-2 small text-secondary">
                                    <i class="bi bi-check2-circle text-success fs-6"></i>
                                    <span>Acesso completo a todas as aulas e cursos</span>
                                </li>
                                <li class="d-flex align-items-start gap-2 small text-secondary">
                                    <i class="bi bi-check2-circle text-success fs-6"></i>
                                    <span>Certificados de conclusão com validação</span>
                                </li>
                            }
                        </ul>
                    </div>
                </div>

                <div class="pt-3 border-top mt-auto">
                    @if (isCurrentPlan)
                    {
                        <button type="button" class="btn btn-outline-success w-100 py-2 rounded-pill fw-bold" disabled>
                            <i class="bi bi-check-lg me-1"></i> Plano Atual
                        </button>
                    }
                    else
                    {
                        <a href="/Assinatura/Checkout?planoId=@plano.Id" class="btn @(plano.Destaque ? "btn-primary" : "btn-outline-primary") w-100 py-2 rounded-pill fw-bold shadow-sm">
                            Assinar Agora <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    }
                </div>
            </div>
        </div>
    }
</div>

<!-- Garantia e Segurança -->
<div class="text-center mt-5 py-4 border-top">
    <div class="d-flex justify-content-center flex-wrap gap-4 text-muted small">
        <div><i class="bi bi-shield-lock-fill text-primary me-1"></i> Pagamento 100% Seguro</div>
        <div><i class="bi bi-lightning-charge-fill text-warning me-1"></i> Ativação Imediata via Pix</div>
        <div><i class="bi bi-infinity text-info me-1"></i> Acesso Ilimitado 24/7</div>
        <div><i class="bi bi-award text-success me-1"></i> Certificados Reconhecidos</div>
    </div>
</div>
