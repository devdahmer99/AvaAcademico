@page
@model AvaAcademico.Pages.Perfil.AnotacoesModel
@{
    ViewData["Title"] = "Minhas Anotações - AVA Acadêmico";
}

<div class="container-fluid px-0">
    <!-- Header / Banner -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);">
        <div class="card-body p-4 p-lg-5 text-white">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="badge bg-info bg-opacity-25 text-info border border-info border-opacity-25 px-3 py-1 rounded-pill">
                            <i class="bi bi-journal-code me-1"></i> Caderno Central do Aluno
                        </span>
                        <span class="badge bg-secondary bg-opacity-50 text-white px-3 py-1 rounded-pill">
                            @Model.TotalAnotacoes anotações salvas
                        </span>
                    </div>
                    <h2 class="fw-bold mb-2 text-white">Minhas Anotações de Estudo</h2>
                    <p class="text-white-50 mb-0" style="max-width: 650px;">
                        Consulte e pesquise comandos, exploits, payloads e notas técnicas tomadas durante as suas aulas práticas e teóricas.
                    </p>
                </div>

                <div class="d-flex align-items-center gap-3">
                    <div class="text-center bg-white bg-opacity-10 rounded-4 px-4 py-3 border border-white border-opacity-10 backdrop-blur">
                        <div class="fs-4 fw-bold text-white mb-0">@Model.TotalAnotacoes</div>
                        <div class="small text-white-50">Anotações</div>
                    </div>
                    <div class="text-center bg-white bg-opacity-10 rounded-4 px-4 py-3 border border-white border-opacity-10 backdrop-blur">
                        <div class="fs-4 fw-bold text-info mb-0">@Model.TotalCursosAnotados</div>
                        <div class="small text-white-50">Cursos</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (TempData["MensagemSucesso"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["MensagemSucesso"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Barra de Pesquisa e Filtros -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white">
        <div class="card-body p-3 p-lg-4">
            <form method="get" class="row g-2 align-items-center">
                <div class="col-12 col-md-9 col-lg-10">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-0 ps-3">
                            <i class="bi bi-search text-muted"></i>
                        </span>
                        <input type="text" name="q" value="@Model.TermoBusca" class="form-control bg-light border-0 py-2" placeholder="Buscar por comando (ex: nmap, sqlmap, curl, suid), aula ou termo..." />
                        @if (!string.IsNullOrWhiteSpace(Model.TermoBusca))
                        {
                            <a href="/Perfil/Anotacoes" class="btn btn-light border-0 text-muted" title="Limpar busca">
                                <i class="bi bi-x-lg"></i>
                            </a>
                        }
                    </div>
                </div>
                <div class="col-12 col-md-3 col-lg-2">
                    <button type="submit" class="btn btn-primary w-100 rounded-3 py-2 fw-semibold shadow-sm">
                        <i class="bi bi-funnel-fill me-1"></i> Filtrar
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Lista de Anotações -->
    @if (!Model.Anotacoes.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 bg-white text-center p-5">
            <div class="py-4">
                <div class="rounded-circle bg-light d-inline-flex p-4 mb-3 text-muted">
                    <i class="bi bi-journal-x fs-1"></i>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.TermoBusca))
                {
                    <h5 class="fw-bold text-dark">Nenhum resultado encontrado</h5>
                    <p class="text-muted mb-3">Nenhuma anotação correspondeu ao termo de busca "<strong>@Model.TermoBusca</strong>".</p>
                    <a href="/Perfil/Anotacoes" class="btn btn-outline-primary rounded-pill px-4">
                        <i class="bi bi-arrow-left me-1"></i> Ver todas as anotações
                    </a>
                }
                else
                {
                    <h5 class="fw-bold text-dark">Você ainda não possui anotações</h5>
                    <p class="text-muted mb-3" style="max-width: 480px; margin: 0 auto;">
                        Ao assistir às aulas, utilize o <strong>Caderno de Anotações</strong> abaixo do reprodutor para registrar comandos, cheatsheets e anotações técnicas!
                    </p>
                    <a href="/" class="btn btn-primary rounded-pill px-4 shadow-sm">
                        <i class="bi bi-play-circle-fill me-1"></i> Ir para Meus Cursos
                    </a>
                }
            </div>
        </div>
    }
    else
    {
        <div class="d-flex flex-column gap-4">
            @foreach (var anotacao in Model.Anotacoes)
            {
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white hover-shadow transition">
                    <!-- Cabeçalho do Card -->
                    <div class="card-header bg-light bg-opacity-50 border-bottom py-3 px-4 d-flex flex-wrap justify-content-between align-items-center gap-2">
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 rounded-pill px-3 py-1">
                                <i class="bi bi-folder2-open me-1"></i> @anotacao.CursoTitulo
                            </span>
                            <span class="text-muted small">
                                <i class="bi bi-chevron-right mx-1"></i> Módulo @anotacao.ModuloOrdem: @anotacao.ModuloTitulo
                            </span>
                            <span class="text-dark fw-bold small">
                                <i class="bi bi-chevron-right mx-1"></i> @anotacao.AulaTitulo
                            </span>
                        </div>

                        <div class="d-flex align-items-center gap-2">
                            <span class="text-muted small">
                                <i class="bi bi-clock-history me-1"></i>@anotacao.AtualizadoEm.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                            </span>
                            <a href="/Aulas/Assistir?id=@anotacao.AulaId" class="btn btn-sm btn-primary rounded-pill px-3 fw-semibold shadow-xs" title="Abrir esta aula">
                                <i class="bi bi-play-circle-fill me-1"></i> Acessar Aula
                            </a>
                        </div>
                    </div>

                    <!-- Corpo com Renderização Formatada das Anotações -->
                    <div class="card-body p-4">
                        <div class="nota-conteudo-formatado" data-raw="@anotacao.Conteudo" style="line-height: 1.7;">
                            <!-- Será renderizado via JavaScript com estilo ofensivo -->
                            <pre class="bg-light p-3 rounded-3 font-monospace text-secondary" style="font-size: 0.88rem; white-space: pre-wrap;">@anotacao.Conteudo</pre>
                        </div>
                    </div>

                    <!-- Rodapé do Card com Ações -->
                    <div class="card-footer bg-white border-top py-2 px-4 d-flex justify-content-between align-items-center text-muted small">
                        <div>
                            <span><i class="bi bi-fonts me-1"></i>@anotacao.Caracteres caracteres</span>
                            <span class="mx-2">•</span>
                            <span><i class="bi bi-list-ol me-1"></i>@anotacao.QuantidadeLinhas linhas</span>
                        </div>

                        <div class="d-flex align-items-center gap-2">
                            <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3" onclick="copiarTextoNota(this)" data-conteudo="@anotacao.Conteudo" title="Copiar todo o texto da nota">
                                <i class="bi bi-clipboard me-1"></i> Copiar Tudo
                            </button>
                            <form method="post" asp-page-handler="Excluir" asp-route-id="@anotacao.Id" onsubmit="return confirm('Tem certeza que deseja excluir esta anotação da aula @anotacao.AulaTitulo? Esta ação não pode ser desfeita.');" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3" title="Excluir anotação">
                                    <i class="bi bi-trash3"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
<script>
    document.addEventListener("DOMContentLoaded", function() {
        // Renderizar todas as caixas de notas com o formatador ofensivo
        document.querySelectorAll('.nota-conteudo-formatado').forEach(container => {
            const raw = container.getAttribute('data-raw');
            if (raw) {
                container.innerHTML = renderizarTextoOfensivo(raw);
            }
        });
    });

    function escapeHtml(text) {
        const map = {
            '&': '&amp;',
            '<': '&lt;',
            '>': '&gt;',
            '"': '&quot;',
            "'": '&#039;'
        };
        return text.replace(/[&<>"']/g, m => map[m]);
    }

    function renderizarTextoOfensivo(raw) {
        let html = escapeHtml(raw);

        // 1. Terminal Blocks (```lang ... ```)
        html = html.replace(/```([a-zA-Z0-9_\-\+]*)\n([\s\S]*?)```/g, function(match, lang, code) {
            const displayLang = (lang || 'bash').trim().toLowerCase();
            const codeClean = code.trim();
            return `
                <div class="my-3 rounded-3 overflow-hidden border border-secondary shadow-sm" style="background-color: #0f172a;">
                    <div class="d-flex justify-content-between align-items-center px-3 py-2 bg-dark bg-opacity-75 border-bottom border-secondary text-light small">
                        <div class="d-flex align-items-center gap-2">
                            <span class="rounded-circle bg-danger d-inline-block" style="width: 10px; height: 10px;"></span>
                            <span class="rounded-circle bg-warning d-inline-block" style="width: 10px; height: 10px;"></span>
                            <span class="rounded-circle bg-success d-inline-block" style="width: 10px; height: 10px;"></span>
                            <span class="ms-2 font-monospace text-muted small"><i class="bi bi-terminal-fill me-1 text-success"></i>${displayLang}</span>
                        </div>
                        <button type="button" class="btn btn-xs btn-outline-light py-0 px-2 rounded font-monospace" onclick="copiarComandoTerminal(this)" style="font-size: 0.75rem;">
                            <i class="bi bi-clipboard me-1"></i>Copiar
                        </button>
                    </div>
                    <pre class="m-0 p-3 text-light font-monospace" style="font-size: 0.88rem; overflow-x: auto; background: transparent;"><code class="text-success">${codeClean}</code></pre>
                </div>
            `;
        });

        // 2. Comandos inline `comando`
        html = html.replace(/`([^`\n]+)`/g, '<code class="bg-dark text-warning px-2 py-1 rounded font-monospace small border border-secondary">$1</code>');

        // 3. Callouts > [!NOTA] ou > [!ATENÇÃO]
        html = html.replace(/&gt;\s*\[!(NOTA|ATENCAO|ATENÇÃO|DICA|INFO)\]\s*\n((?:&gt;.*(?:\n|$))*)/gi, function(match, type, content) {
            const cleanContent = content.replace(/&gt;\s?/g, '').trim();
            const typeUp = type.toUpperCase();
            let icon = "bi-lightbulb-fill text-warning";
            let alertClass = "alert-warning border-warning";
            if (typeUp.includes("ATEN")) {
                icon = "bi-exclamation-triangle-fill text-danger";
                alertClass = "alert-danger border-danger";
            } else if (typeUp.includes("INFO") || typeUp.includes("DICA")) {
                icon = "bi-info-circle-fill text-info";
                alertClass = "alert-info border-info";
            }
            return `
                <div class="alert ${alertClass} border-start border-4 rounded-3 p-3 my-3 shadow-xs">
                    <div class="fw-bold mb-1 d-flex align-items-center gap-1">
                        <i class="bi ${icon} me-1"></i> ${typeUp}
                    </div>
                    <div class="small" style="white-space: pre-line;">${cleanContent}</div>
                </div>
            `;
        });

        // 4. Blockquotes comuns
        html = html.replace(/(?:^|\n)&gt;\s?(.*?)(?=\n|$)/g, '\n<blockquote class="border-start border-3 border-primary ps-3 text-secondary my-2 fst-italic">$1</blockquote>');

        // 5. Títulos
        html = html.replace(/^###\s+(.*?)$/gm, '<h5 class="fw-bold text-dark mt-3 mb-2">$1</h5>');
        html = html.replace(/^##\s+(.*?)$/gm, '<h4 class="fw-bold text-dark mt-4 mb-2 pb-1 border-bottom">$1</h4>');
        html = html.replace(/^#\s+(.*?)$/gm, '<h3 class="fw-bold text-dark mt-4 mb-3">$1</h3>');

        // 6. Negrito e Itálico
        html = html.replace(/\*\*([^*]+)\*\*/g, '<strong class="text-dark">$1</strong>');
        html = html.replace(/\*([^*]+)\*/g, '<em class="text-secondary">$1</em>');

        // 7. Listas
        html = html.replace(/(?:^|\n)-\s+(.*?)(?=\n|$)/g, '\n<li class="ms-3 text-secondary">$1</li>');

        // 8. Quebras de linha
        html = html.replace(/\n\n+/g, '<div class="my-2"></div>');
        html = html.replace(/\n(?![<\s])/g, '<br>');

        return html;
    }

    function copiarComandoTerminal(btn) {
        const container = btn.closest('.my-3');
        if (!container) return;
        const code = container.querySelector('code');
        if (!code) return;

        navigator.clipboard.writeText(code.innerText).then(() => {
            const originalHtml = btn.innerHTML;
            btn.className = "btn btn-xs btn-success py-0 px-2 rounded font-monospace";
            btn.innerHTML = '<i class="bi bi-check-lg me-1"></i>Copiado!';
            setTimeout(() => {
                btn.className = "btn btn-xs btn-outline-light py-0 px-2 rounded font-monospace";
                btn.innerHTML = originalHtml;
            }, 2000);
        });
    }

    function copiarTextoNota(btn) {
        const texto = btn.getAttribute('data-conteudo');
        if (!texto) return;

        navigator.clipboard.writeText(texto).then(() => {
            const originalHtml = btn.innerHTML;
            btn.className = "btn btn-sm btn-success rounded-pill px-3";
            btn.innerHTML = '<i class="bi bi-check-lg me-1"></i> Copiado!';
            setTimeout(() => {
                btn.className = "btn btn-sm btn-outline-secondary rounded-pill px-3";
                btn.innerHTML = originalHtml;
            }, 2000);
        });
    }
</script>
}

